---
import type { Locale } from "../types/site";
import { NAV, SITE_NAME } from "../config/site";
import { t } from "../i18n/ui";
import { withBase } from "../config/links";

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const text = t(locale);
const navItems = NAV[locale];
const normalize = (value: string) => value.replace(/\/+$/, "") || "/";
const currentPath = normalize(pathname);
---
<header class="site-header">
  <div class="container header-inner">
    <a href={withBase(locale === "it" ? "/" : "/en")} class="brand" aria-label={SITE_NAME}>{SITE_NAME}</a>
    <nav aria-label={text.navLabel} class="main-nav">
      {navItems.map((item) => (
        <a
          href={withBase(item.href)}
          aria-current={currentPath === normalize(withBase(item.href)) ? "page" : undefined}
          class:list={{ active: currentPath === normalize(withBase(item.href)) }}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <a class="lang-switch" href={withBase(text.langHref)}>{text.langSwitch}</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme" aria-pressed="false">
        <span aria-hidden="true">◐</span>
      </button>
    </div>
  </div>
</header>
