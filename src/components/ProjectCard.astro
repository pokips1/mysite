---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../types/site";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
  project: CollectionEntry<"projects">;
}

const { locale, project } = Astro.props;
const text = t(locale);
const { title, summary, sector, tech, cover, liveUrl, results } = project.data;
---
<article class="project-card" data-reveal>
  <img src={cover} alt={title} loading="lazy" width="1200" height="700" />
  <div class="project-body">
    <h3>{title}</h3>
    <p>{summary}</p>
    <ul class="meta-list">
      <li><strong>{text.sector}:</strong> {sector}</li>
      <li><strong>{text.stack}:</strong> {tech.join(", ")}</li>
      <li><strong>{text.result}:</strong> {results}</li>
    </ul>
    <a class="btn btn-link" href={liveUrl} target="_blank" rel="noopener noreferrer">{text.visitSite}</a>
  </div>
</article>