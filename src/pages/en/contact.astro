---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaButtons from "../../components/CtaButtons.astro";
import { t } from "../../i18n/ui";
import { createSeo } from "../../config/seo";
import { CONTACT } from "../../config/site";

const locale = "en" as const;
const text = t(locale);
const seo = createSeo({
  locale,
  path: "/en/contact",
  title: "Contact",
  description: "Get in touch via WhatsApp or email and receive a concrete website proposal.",
  alternates: { it: "/contattami", en: "/en/contact" }
});

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Typical timeline",
      acceptedAnswer: { "@type": "Answer", text: "Projects usually take 5 to 15 working days, depending on scope." }
    },
    {
      "@type": "Question",
      name: "Pricing",
      acceptedAnswer: { "@type": "Answer", text: "Pricing starts from EUR 600 and is defined according to business goals." }
    }
  ]
};
---
<BaseLayout locale={locale} seo={seo}>
  <section class="container hero" data-reveal>
    <h1>{text.contactTitle}</h1>
    <p>{text.contactLead}</p>
    <CtaButtons locale={locale} />
  </section>

  <section class="container card" data-reveal>
    <h2>{text.faqTitle}</h2>
    <dl>
      <dt><strong>Typical timeline</strong></dt>
      <dd>5 to 15 working days depending on project scope.</dd>
      <dt><strong>Pricing</strong></dt>
      <dd>Projects start from EUR 600 based on business goals.</dd>
    </dl>
    <p><strong>Direct email:</strong> <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
  </section>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</BaseLayout>
