---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaButtons from "../../components/CtaButtons.astro";
import { t } from "../../i18n/ui";
import { createSeo } from "../../config/seo";
import { CONTACT } from "../../config/site";

const locale = "en" as const;
const text = t(locale);
const seo = createSeo({
  locale,
  path: "/en/contact",
  title: "Contact",
  description: "Get in touch via WhatsApp or email and receive a concrete website proposal.",
  alternates: { it: "/contattami", en: "/en/contact" }
});
---
<BaseLayout locale={locale} seo={seo}>
  <section class="container hero" data-reveal>
    <h1>{text.contactTitle}</h1>
    <p>{text.contactLead}</p>
    <CtaButtons locale={locale} />
  </section>

  <section class="container card" data-reveal>
    <h2>{text.faqTitle}</h2>
    <p><strong>Typical timeline:</strong> 5 to 15 working days depending on project scope.</p>
    <p><strong>Pricing:</strong> projects start from EUR 600 based on business goals.</p>
    <p><strong>Direct email:</strong> <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
  </section>
</BaseLayout>