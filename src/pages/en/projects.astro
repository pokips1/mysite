---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { t } from "../../i18n/ui";
import { createSeo } from "../../config/seo";

const locale = "en" as const;
const text = t(locale);
const projects = await getCollection("projects", ({ data }) => data.lang === "en");
const seo = createSeo({
  locale,
  path: "/en/projects",
  title: "Projects",
  description: "Selected static website projects with stack, goals and outcomes.",
  alternates: { it: "/progetti", en: "/en/projects" }
});
---
<BaseLayout locale={locale} seo={seo}>
  <section class="container hero" data-reveal>
    <h1>{text.projectsTitle}</h1>
    <p>{text.projectsLead}</p>
  </section>

  <section class="container" data-reveal>
    <div class="project-list">
      {projects.map((project) => <ProjectCard locale={locale} project={project} />)}
    </div>
  </section>
</BaseLayout>