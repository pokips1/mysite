---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaButtons from "../components/CtaButtons.astro";
import { t } from "../i18n/ui";
import { createSeo } from "../config/seo";
import { CONTACT } from "../config/site";

const locale = "it" as const;
const text = t(locale);
const seo = createSeo({
  locale,
  path: "/contattami",
  title: "Contattami",
  description: "Contattami su WhatsApp o email per ricevere una proposta per il tuo nuovo sito web statico.",
  alternates: { it: "/contattami", en: "/en/contact" }
});

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Tempi medi",
      acceptedAnswer: { "@type": "Answer", text: "Da 5 a 15 giorni lavorativi, in base alla complessita del progetto." }
    },
    {
      "@type": "Question",
      name: "Prezzo",
      acceptedAnswer: { "@type": "Answer", text: "I progetti partono da 600 EUR, con preventivo calibrato su obiettivi e scope." }
    }
  ]
};
---
<BaseLayout locale={locale} seo={seo}>
  <section class="container hero" data-reveal>
    <h1>{text.contactTitle}</h1>
    <p>{text.contactLead}</p>
    <CtaButtons locale={locale} />
  </section>

  <section class="container card" data-reveal>
    <h2>{text.faqTitle}</h2>
    <dl>
      <dt><strong>Tempi medi</strong></dt>
      <dd>Da 5 a 15 giorni lavorativi, in base alla complessita.</dd>
      <dt><strong>Prezzo</strong></dt>
      <dd>Progetti a partire da 600 EUR, con preventivo su obiettivi e scope.</dd>
    </dl>
    <p><strong>Email diretta:</strong> <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
  </section>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</BaseLayout>
